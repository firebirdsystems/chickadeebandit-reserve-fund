{
  "id": "reserve-fund",
  "contexts": ["household", "shared_space"],
  "name": "Reserve Fund Dashboard",
  "version": "2.0.0",
  "description": "Track organization capital reserve funds — balances, goals, deposit/withdrawal ledger, capital project planning, and balance-over-time charts. Board manages; all members can view.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "organization",
  "tags": ["hoa", "reserve", "finance", "capital", "board"],
  "exports": ["funds-list"],
  "data_access": {
    "reads": ["family.groups"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": true
  },
  "storage": "db",
  "preload": {
    "funds": {"sql": "SELECT * FROM app_reserve_fund__funds ORDER BY created_at ASC LIMIT 200"},
    "projects": {"sql": "SELECT * FROM app_reserve_fund__projects ORDER BY created_at DESC LIMIT 500"},
    "manual_totals": {"sql": "SELECT fund_id, SUM(amount_cents) AS total_cents FROM app_reserve_fund__manual_tx GROUP BY fund_id"},
    "board_group": {"sql": "SELECT value FROM app_reserve_fund__settings WHERE key = 'board_group_id'"}
  },
  "db_plaintext_columns": ["operation"],
  "icon": "🏦",
  "member_references": {
    "funds": { "column": "created_by", "on_removed": "keep" },
    "manual_tx": { "column": "created_by", "on_removed": "keep" },
    "projects": { "column": "created_by", "on_removed": "keep" },
    "imported_tx": { "column": "posted_by_id", "on_removed": "keep" }
  },
  "resource_limits": { "max_db_bytes": 104857600 },
  "nav": { "label": "Reserve Funds" },
  "publishes": ["reserve_fund.transaction_recorded", "reserve_fund.project_planned"],
  "publish_acls": {
    "reserve_fund.transaction_recorded": {
      "require_group_setting": { "settings_table": "settings", "settings_key": "board_group_id" }
    },
    "reserve_fund.project_planned": {
      "require_group_setting": { "settings_table": "settings", "settings_key": "board_group_id" }
    }
  },
  "row_policies": {
    "settings": { "kind": "app_config" },
    "funds": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_privileged_only": true,
      "privileged_groups": [{ "settings_table": "settings", "settings_key": "board_group_id" }]
    },
    "manual_tx": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_privileged_only": true,
      "privileged_groups": [{ "settings_table": "settings", "settings_key": "board_group_id" }]
    },
    "projects": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_privileged_only": true,
      "privileged_groups": [{ "settings_table": "settings", "settings_key": "board_group_id" }]
    },
    "imported_tx": { "kind": "endpoint_only", "read": "everyone" }
  },
  "admin_config": {
    "settings_table": "settings",
    "keys": ["board_group_id"]
  },
  "store_acls": {
    "funds-list": {
      "write": {
        "require_group_setting": { "settings_table": "settings", "settings_key": "board_group_id" }
      }
    }
  },
  "financial_ledger_imports": {
    "transactions": {
      "table": "imported_tx",
      "funds_table": "funds",
      "allowed_source_apps": ["dues-contributions"],
      "require_group_setting": { "settings_table": "settings", "settings_key": "board_group_id" }
    }
  }
}
